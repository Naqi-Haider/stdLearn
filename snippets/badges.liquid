{% assign custom_badges_collect = product.metafields.custom.badge %}

<div>
    {% for custom_badge in custom_badges_collect %}
        {% assign custom_badge_parts = custom_badge | split: '|' %}
        {% assign custom_badge_text = custom_badge_parts[0] %}
        {% assign custom_badge_bg = custom_badge_parts[1] %}
        {% assign custom_badge_color = custom_badge_parts[2] %}
        <span style="
            background-color: {{ custom_badge_bg }};
            color: {{custom_badge_color}}
            ">
            {{ custom_badge_text }}
        </span>
    {% endfor %}
</div>
